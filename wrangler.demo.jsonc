{
  "name": "async-geotiff-demo",
  "main": "cloudflare-demo/src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "containers": [
    {
      "class_name": "DemoContainer",
      "image": "./Dockerfile.demo",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "DEMO_CONTAINER", "class_name": "DemoContainer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DemoContainer"] }]
}
